---
import '@fontsource/dm-serif-display/400.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/caveat/500.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Loft Boiçucanga · Guia do Hóspede & Praias de São Sebastião',
  description = 'Bem-vindo ao Loft Boiçucanga! Wi-Fi com 1 toque, regras rápidas da casa e guia interativo das melhores praias e cachoeiras de São Sebastião.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF5EC" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body class="bg-bg text-ink font-sans antialiased selection:bg-sea-soft selection:text-ink overflow-x-hidden">
    <!-- Textura sutil de linho / papel artesanal (Paleta C) -->
    <div class="linen-texture pointer-events-none fixed inset-0 z-0" aria-hidden="true"></div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #FAF5EC;
    --surface: #FFFCF6;
    --sand: #F1E5D1;
    --sand-deep: #E5D0B0;
    --ink: #3A2F2A;
    --muted: #73665E;
    --sea: #5E9AA0;
    --sea-ink: #3F7479;
    --sea-soft: #DCEEEC;
    --leaf: #8A9A5B;
    --leaf-soft: #E9EDD8;
    --sun: #A9502F;
    --sun-soft: #F8DFD3;
    --line: rgba(58, 47, 42, 0.10);
    --shadow-1: 0 1px 2px rgba(70, 48, 30, 0.05), 0 10px 28px rgba(70, 48, 30, 0.07);
    --shadow-2: 0 4px 10px rgba(70, 48, 30, 0.09), 0 24px 52px rgba(70, 48, 30, 0.17);
  }

  /* Textura sutil de linho (SVG noise leve) */
  .linen-texture {
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
  }

  /* Animação orgânica da onda indo e voltando (maré na areia) */
  @keyframes tideInAndOut {
    0%, 100% {
      transform: translate3d(0, -10px, 0) scaleY(0.94);
    }
    50% {
      transform: translate3d(0, 14px, 0) scaleY(1.08);
    }
  }

  @keyframes tideInAndOutSlow {
    0%, 100% {
      transform: translate3d(0, 10px, 0) scaleY(1.05);
    }
    50% {
      transform: translate3d(0, -12px, 0) scaleY(0.92);
    }
  }

  @keyframes waveHorizontalA {
    0%, 100% {
      transform: translate3d(-2%, 0, 0);
    }
    50% {
      transform: translate3d(2%, 0, 0);
    }
  }

  @keyframes waveHorizontalB {
    0%, 100% {
      transform: translate3d(2.5%, 0, 0);
    }
    50% {
      transform: translate3d(-2.5%, 0, 0);
    }
  }

  @keyframes foamPulse {
    0%, 100% {
      opacity: 0.55;
      transform: translate3d(0, -6px, 0) scaleY(0.96);
    }
    50% {
      opacity: 0.95;
      transform: translate3d(0, 16px, 0) scaleY(1.1);
    }
  }

  .wave-tide-1 {
    animation: tideInAndOut 5.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    will-change: transform;
  }
  .wave-tide-2 {
    animation: tideInAndOutSlow 7.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    will-change: transform;
  }
  .wave-tide-foam {
    animation: foamPulse 5.6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    will-change: transform, opacity;
  }
  .wave-slide-a {
    animation: waveHorizontalA 8s ease-in-out infinite;
  }
  .wave-slide-b {
    animation: waveHorizontalB 10s ease-in-out infinite;
  }

  /* Cartões weightless (Antigravity Design) */
  .ag-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: var(--shadow-1);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ag-card-interactive:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-2);
  }

  .ag-glass {
    background: rgba(255, 252, 246, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 252, 246, 0.85);
    box-shadow: var(--shadow-1);
  }

  /* Carrossel de Pilhas de Polaroids (SEM texto na moldura da foto) */
  .polaroid-stage {
    position: relative;
    height: 410px;
    overflow: hidden;
    perspective: 1200px;
    touch-action: pan-y;
    user-select: none;
  }

  .polaroid-stack {
    position: absolute;
    left: 50%;
    top: 48%;
    width: 240px;
    height: 270px;
    margin: -135px 0 0 -120px;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease;
    cursor: pointer;
    transform-style: preserve-3d;
  }

  .polaroid-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 162px;
    background: var(--surface);
    padding: 9px 9px 22px 9px;
    border-radius: 3px;
    border: 1px solid rgba(58, 47, 42, 0.07);
    box-shadow: var(--shadow-1);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
    will-change: transform;
  }

  .polaroid-card img {
    width: 100%;
    height: 156px;
    object-fit: cover;
    display: block;
    border-radius: 2px;
    pointer-events: none;
    background: var(--sand);
  }

  .polaroid-card.is-landscape {
    width: 192px;
  }
  .polaroid-card.is-landscape img {
    height: 128px;
  }

  .polaroid-card.is-placeholder {
    background: var(--surface);
    border: 2px dashed var(--sand-deep);
    box-shadow: none;
  }

  .polaroid-stack.is-active.is-fanned .polaroid-card:hover {
    box-shadow: var(--shadow-2);
    z-index: 30 !important;
  }

  @media (hover: none), (max-width: 639px) {
    .polaroid-stage {
      height: 500px;
    }
    .polaroid-stack {
      top: 47%;
    }
    .polaroid-card {
      width: 146px;
      padding: 7px 7px 18px 7px;
    }
    .polaroid-card img {
      height: 138px;
    }
    .polaroid-card.is-landscape {
      width: 160px;
    }
    .polaroid-card.is-landscape img {
      height: 116px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-tide-1,
    .wave-tide-2,
    .wave-tide-foam,
    .wave-slide-a,
    .wave-slide-b,
    .polaroid-stack,
    .polaroid-card,
    .ag-card {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
