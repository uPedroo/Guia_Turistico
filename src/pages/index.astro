      trees: '<path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z"/><path d="M7 16v6"/><path d="M13 19v3"/><path d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5"/>',
      smile: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/>',
      users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
      moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
      car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
      pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
      camera: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/>',
      play: '<polygon points="6 3 20 12 6 21 6 3"/>'
    };

    const renderSvg = (name: string, size = 17) =>
      `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${SVG_PATHS[name] || SVG_PATHS.sparkles}</svg>`;

    let currentLang = 'pt';
    let activePlaceIndex = 0;
    let swiped = false;

    const REST_POS = [
      { x: -38, y: 14, r: -8 },
      { x: 42, y: 4, r: 7 },
      { x: -2, y: -22, r: -3 },
      { x: 6, y: 42, r: 4 }
    ];
    const DESKTOP_FAN_POS = [
      { x: -128, y: -8, r: -13 },
      { x: 128, y: -6, r: 12 },
      { x: -42, y: -42, r: -4 },
      { x: 46, y: 38, r: 5 }
    ];
    const MOBILE_SPREAD_POS = [
      { x: -80, y: -92, r: -5 },
      { x: 82, y: -86, r: 4 },
      { x: -78, y: 88, r: 3 },
      { x: 82, y: 94, r: -4 }
    ];

    const isTouchOrMobile = () =>
      window.matchMedia('(hover: none)').matches || window.innerWidth < 640;

    const stage = document.getElementById('polaroid-stage')!;
    const dotsContainer = document.getElementById('carousel-dots')!;
    const infoPanel = document.getElementById('place-info-panel')!;

    const stackElements: HTMLElement[] = SITE.places.map((place: any, placeIdx: number) => {
      const stackEl = document.createElement('div');
      stackEl.className = 'polaroid-stack';
      stackEl.dataset.index = String(placeIdx);

      const photos: string[] = (place.photos || []).slice(0, 4);
      const cardsData: Array<{ src?: string; placeholder?: boolean; photoIndex: number }> = photos.map(
        (src, idx) => ({ src, photoIndex: idx })
      );
      while (cardsData.length < 3) {
        cardsData.push({ placeholder: true, photoIndex: cardsData.length });
      }

      cardsData.forEach((card, k) => {
        const pol = document.createElement('div');
        pol.className = 'polaroid-card' + (card.placeholder ? ' is-placeholder' : '');
        pol.dataset.k = String(k);
        pol.style.zIndex = String(k + 1);

        if (card.placeholder) {
          pol.innerHTML = `
            <div class="h-[138px] sm:h-[156px] rounded-[2px] bg-sand/70 flex flex-col items-center justify-center gap-2 text-muted text-xs px-2 text-center">
              ${renderSvg('camera', 24)}
              <span class="ph-label">${UI_TEXT[currentLang].photoSoon}</span>
            </div>
          `;
        } else {
          pol.innerHTML = `<img src="${card.src}" alt="${place.name} - foto ${k + 1}" loading="lazy" />`;
          const imgEl = pol.querySelector('img')!;
          imgEl.addEventListener('load', () => {
            if (imgEl.naturalWidth > imgEl.naturalHeight * 1.1) {
              pol.classList.add('is-landscape');
            }
          });

          pol.addEventListener('click', (e) => {
            if (swiped) return;
            if (Number(stackEl.dataset.index) === activePlaceIndex && stackEl.classList.contains('is-fanned')) {
              e.stopPropagation();
              openLightbox(placeIdx, card.photoIndex);
            }
          });
        }

        pol.addEventListener('mouseenter', () => {
          if (stackEl.classList.contains('is-fanned') && !isTouchOrMobile()) {
            liftCard(pol, k, true);
          }
        });
        pol.addEventListener('mouseleave', () => {
          if (stackEl.classList.contains('is-fanned') && !isTouchOrMobile()) {
            liftCard(pol, k, false);
          }
        });

        stackEl.appendChild(pol);
      });

      stackEl.addEventListener('mouseenter', () => {
        if (Number(stackEl.dataset.index) === activePlaceIndex && !isTouchOrMobile()) {
          setStackFan(stackEl, true);
        }
      });
      stackEl.addEventListener('mouseleave', () => {
        if (!isTouchOrMobile()) {
          setStackFan(stackEl, false);
        }
      });
      stackEl.addEventListener('click', () => {
        if (swiped) return;
        const idx = Number(stackEl.dataset.index);
        if (idx !== activePlaceIndex) {
          goToPlace(idx);
        }
      });

      stage.appendChild(stackEl);
      return stackEl;
    });

    SITE.places.forEach((place: any, idx: number) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', place.name);
      dot.className = 'h-2 rounded-full transition-all duration-300 bg-sand-deep w-2';
      dot.addEventListener('click', () => goToPlace(idx));
      dotsContainer.appendChild(dot);
    });

    function formatTransform(p: { x: number; y: number; r: number }, extra = '') {
      return `translate(-50%, -50%) translate3d(${p.x}px, ${p.y}px, 0) rotate(${p.r}deg) ${extra}`;
    }

    function positionCards(stackEl: HTMLElement, fanned: boolean) {
      const coords = fanned ? (isTouchOrMobile() ? MOBILE_SPREAD_POS : DESKTOP_FAN_POS) : REST_POS;
      stackEl.querySelectorAll<HTMLElement>('.polaroid-card').forEach((card, k) => {
        const p = coords[k % 4];
        card.style.transform = formatTransform(p);
        card.style.zIndex = String(k + 1);
      });
    }

    function setStackFan(stackEl: HTMLElement, fanned: boolean) {
      stackEl.classList.toggle('is-fanned', fanned);
      positionCards(stackEl, fanned);
    }

    function liftCard(cardEl: HTMLElement, k: number, lift: boolean) {
      const p = DESKTOP_FAN_POS[k % 4];
      if (lift) {
        cardEl.style.transform = `translate(-50%, -50%) translate3d(${p.x * 1.05}px, ${p.y - 14}px, 20px) rotate(0deg) scale(1.15)`;
        cardEl.style.zIndex = '30';
      } else {
        cardEl.style.transform = formatTransform(p);
        cardEl.style.zIndex = String(k + 1);
      }
    }

    function renderActivePlaceInfo() {
      const place = SITE.places[activePlaceIndex];
      const t = UI_TEXT[currentLang];

      const tagsHtml = (place.tags || [])
        .map((tag: any) => {
          const toneClasses =
            tag.tone === 'sea'
              ? 'bg-sea-soft text-sea-ink'
              : tag.tone === 'leaf'
              ? 'bg-leaf-soft text-leaf'
              : 'bg-sun-soft text-sun';
          return `
            <span class="inline-flex items-center gap-2 pl-2 pr-3.5 py-1.5 rounded-full bg-surface border border-ink/10 text-xs sm:text-sm font-medium text-ink shadow-sm">
              <span class="w-7 h-7 rounded-full flex items-center justify-center ${toneClasses}">
                ${renderSvg(tag.icon, 16)}
              </span>
              <span>${tag.label[currentLang] || tag.label.pt}</span>
            </span>
          `;
        })
        .join('');

      const hasAllPhotos = (place.photos || []).length > 0;
      const videoButtonHtml = place.video
        ? `<button type="button" id="open-place-video" class="px-4 py-2.5 rounded-full bg-sea-soft text-sea-ink font-semibold text-xs sm:text-sm inline-flex items-center gap-2 hover:bg-sea hover:text-surface transition-colors">
            ${renderSvg('play', 15)}
            <span>${t.watchVideo}</span>
          </button>`
        : '';

      const allPhotosButtonHtml =
        (place.photos || []).length > 4
          ? `<button type="button" id="open-all-photos" class="px-4 py-2.5 rounded-full bg-sand/80 text-ink font-semibold text-xs sm:text-sm inline-flex items-center gap-2 hover:bg-sand-deep transition-colors">
              ${renderSvg('camera', 15)}
              <span>${t.allPhotosBtn} (${place.photos.length})</span>
            </button>`
          : '';

      const warningHtml = place.warning
        ? `<div class="max-w-xl mx-auto rounded-2xl bg-sun-soft/80 border border-sun/30 px-4 py-3 text-xs sm:text-sm text-ink font-medium leading-relaxed">
            <strong class="text-sun font-bold">⚠️ Atenção:</strong> ${place.warning[currentLang] || place.warning.pt}
          </div>`
        : '';

      infoPanel.innerHTML = `
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-muted">
            <span>${place.category[currentLang] || place.category.pt}</span>
            <span>·</span>
            <span class="inline-flex items-center gap-1 text-sea-ink">
              ${renderSvg('car', 14)}
              ${place.driveTime} (${place.distanceKm})
            </span>
          </div>

          <h3 class="font-display text-3xl md:text-4xl text-ink">${place.name}</h3>

          <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
            ${tagsHtml}
          </div>

          ${warningHtml}

          <p class="text-sm md:text-base text-muted max-w-xl mx-auto leading-relaxed bg-bg/80 border border-ink/5 rounded-2xl p-4">
            “${place.tip[currentLang] || place.tip.pt}”
          </p>

          <div class="flex flex-wrap items-center justify-center gap-2.5 pt-1">
            <a
              href="${place.mapsUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full bg-sun text-surface font-semibold text-xs sm:text-sm shadow-sm hover:-translate-y-0.5 transition-transform inline-flex items-center gap-2"
            >
              ${renderSvg('pin', 16)}
              <span>${t.openMaps}</span>
            </a>
            <a
              href="${place.wazeUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full bg-surface text-ink border border-ink/15 font-semibold text-xs sm:text-sm hover:-translate-y-0.5 transition-transform inline-flex items-center gap-2"
            >
              ${renderSvg('car', 16)}
              <span>${t.openWaze}</span>
            </a>
            ${videoButtonHtml}
            ${allPhotosButtonHtml}
          </div>
        </div>
      `;

      if (place.video) {
        document.getElementById('open-place-video')?.addEventListener('click', () => {
          openVideoLightbox(place.video);
        });
      }
      if (hasAllPhotos && place.photos.length > 4) {
        document.getElementById('open-all-photos')?.addEventListener('click', () => {
          openLightbox(activePlaceIndex, 0);
        });
      }
    }

    function updateCarouselLayout() {
      const stageWidth = stage.clientWidth;
      const mobile = isTouchOrMobile();
      const gap = mobile ? stageWidth * 0.80 : Math.max(260, Math.min(stageWidth * 0.48, 400));
      const total = stackElements.length;

      stackElements.forEach((stackEl, i) => {
        let diff = i - activePlaceIndex;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;

        const isActive = diff === 0;
        const scale = isActive ? 1 : 0.66;
        const opacity = Math.abs(diff) > 1 ? 0 : isActive ? 1 : 0.5;

        stackEl.style.transform = `translate3d(${diff * gap}px, 0, 0) scale(${scale})`;
        stackEl.style.opacity = String(opacity);
        stackEl.style.zIndex = String(15 - Math.abs(diff));
        stackEl.style.pointerEvents = Math.abs(diff) > 1 ? 'none' : 'auto';
        stackEl.classList.toggle('is-active', isActive);

        if (isActive && mobile) {
          setStackFan(stackEl, true);
        } else {
          setStackFan(stackEl, false);
        }
      });

      dotsContainer.querySelectorAll('button').forEach((dot, i) => {
        if (i === activePlaceIndex) {
          dot.className = 'h-2 rounded-full transition-all duration-300 bg-sea w-7';
        } else {
          dot.className = 'h-2 rounded-full transition-all duration-300 bg-sand-deep w-2';
        }
      });

      document.querySelectorAll<HTMLButtonElement>('.beach-pill').forEach((pill, i) => {
        if (i === activePlaceIndex) {
          pill.className = 'beach-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all bg-ink text-surface border-ink shadow-sm';
        } else {
          pill.className = 'beach-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all bg-surface text-muted border-ink/10 hover:text-ink';
        }
      });

      renderActivePlaceInfo();
    }

    function goToPlace(index: number) {
      const total = stackElements.length;
      activePlaceIndex = (index + total) % total;
      updateCarouselLayout();
    }

    document.getElementById('carousel-prev')?.addEventListener('click', () => goToPlace(activePlaceIndex - 1));
    document.getElementById('carousel-next')?.addEventListener('click', () => goToPlace(activePlaceIndex + 1));

    document.querySelectorAll<HTMLButtonElement>('.beach-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        goToPlace(Number(pill.dataset.placeIndex));
      });
    });

    let pointerStartX: number | null = null;
    stage.addEventListener('pointerdown', (e) => {
      pointerStartX = e.clientX;
      swiped = false;
    });
    stage.addEventListener('pointerup', (e) => {
      if (pointerStartX === null) return;
      const dx = e.clientX - pointerStartX;
      if (Math.abs(dx) > 48) {
        swiped = true;
        goToPlace(activePlaceIndex + (dx < 0 ? 1 : -1));
        setTimeout(() => {
          swiped = false;
        }, 60);
      }
      pointerStartX = null;
    });

    window.addEventListener('resize', updateCarouselLayout);

    // Lightbox
    const lightbox = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbVideo = document.getElementById('lb-video') as HTMLVideoElement;
    const lbCounter = document.getElementById('lb-counter')!;
    let lbPhotosList: string[] = [];
    let lbCurrentPhotoIdx = 0;

    function showLightboxImage() {
      lbVideo.pause();
      lbVideo.classList.add('hidden');
      lbImg.classList.remove('hidden');
      lbImg.src = lbPhotosList[lbCurrentPhotoIdx];
      lbCounter.textContent = `${lbCurrentPhotoIdx + 1} / ${lbPhotosList.length}`;
    }

    function openLightbox(placeIdx: number, photoIdx: number) {
      const photos = SITE.places[placeIdx]?.photos || [];
      if (!photos.length) return;
      lbPhotosList = photos;
      lbCurrentPhotoIdx = photoIdx;
      showLightboxImage();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    }

    function openCustomPhotosLightbox(photos: string[], startIdx: number) {
      lbPhotosList = photos;
      lbCurrentPhotoIdx = startIdx;
      showLightboxImage();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    }

    function openVideoLightbox(videoSrc: string) {
      lbImg.classList.add('hidden');
      lbVideo.classList.remove('hidden');
      lbVideo.src = videoSrc;
      lbCounter.textContent = SITE.places[activePlaceIndex].name;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      lbVideo.play().catch(() => {});
    }

    function closeLightbox() {
      lbVideo.pause();
      lbVideo.src = '';
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }

    document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lb-prev')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!lbPhotosList.length) return;
      lbCurrentPhotoIdx = (lbCurrentPhotoIdx - 1 + lbPhotosList.length) % lbPhotosList.length;
      showLightboxImage();
    });
    document.getElementById('lb-next')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!lbPhotosList.length) return;
      lbCurrentPhotoIdx = (lbCurrentPhotoIdx + 1) % lbPhotosList.length;
      showLightboxImage();
    });
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.querySelectorAll<HTMLButtonElement>('.house-photo-btn').forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        openCustomPhotosLightbox(SITE.property.housePhotos, idx);
      });
    });

    window.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') document.getElementById('lb-prev')?.click();
        if (e.key === 'ArrowRight') document.getElementById('lb-next')?.click();
      } else {
        if (e.key === 'ArrowLeft') goToPlace(activePlaceIndex - 1);
        if (e.key === 'ArrowRight') goToPlace(activePlaceIndex + 1);
      }
    });

    // Copiar senha do Wi-Fi com 1 toque
    const copyWifiBtn = document.getElementById('copy-wifi-btn');
    const copyWifiLabel = document.getElementById('copy-wifi-label');
    copyWifiBtn?.addEventListener('click', async () => {
      const pass = copyWifiBtn.getAttribute('data-password') || '';
      try {
        await navigator.clipboard.writeText(pass);
      } catch {}
      if (copyWifiLabel) {
        copyWifiLabel.textContent = UI_TEXT[currentLang].copiedBtn;
        setTimeout(() => {
          copyWifiLabel.textContent = UI_TEXT[currentLang].copyBtn;
        }, 2200);
      }
    });

    // Troca de Idioma (PT / ES / EN)
    function setLanguage(lang: string) {
      currentLang = lang;
      const t = UI_TEXT[lang];

      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const key = el.dataset.i18n!;
        if (t[key]) el.textContent = t[key];
      });

      document.querySelectorAll<HTMLElement>('.rule-card').forEach((card, idx) => {
        const rule = SITE.basicRules[idx];
        if (!rule) return;
        const titleEl = card.querySelector('.rule-title');
        const descEl = card.querySelector('.rule-desc');
        if (titleEl) titleEl.textContent = rule.title[lang];
        if (descEl) descEl.textContent = rule.desc[lang];
      });

      document.querySelectorAll<HTMLElement>('[data-guide-idx]').forEach((card) => {
        const idx = Number(card.dataset.guideIdx);
        const item = SITE.houseGuide[idx];
        if (!item) return;
        const titleEl = card.querySelector('.guide-title');
        const descEl = card.querySelector('.guide-desc');
        if (titleEl) titleEl.textContent = item.title[lang];
        if (descEl) descEl.textContent = item.desc[lang];
      });

      document.querySelectorAll<HTMLElement>('[data-nearby-idx]').forEach((card) => {
        const idx = Number(card.dataset.nearbyIdx);
        const item = SITE.nearbyWalk[idx];
        if (!item) return;
        const titleEl = card.querySelector('.nearby-title');
        const descEl = card.querySelector('.nearby-desc');
        if (titleEl) titleEl.textContent = item.title[lang];
        if (descEl) descEl.textContent = item.desc[lang];
      });

      document.querySelectorAll<HTMLElement>('[data-faq-idx]').forEach((card) => {
        const idx = Number(card.dataset.faqIdx);
        const item = SITE.faq[idx];
        if (!item) return;
        const qEl = card.querySelector('.faq-q');
        const aEl = card.querySelector('.faq-a');
        if (qEl) qEl.textContent = item.q[lang];
        if (aEl) aEl.textContent = item.a[lang];
      });

      document.querySelectorAll<HTMLElement>('.ph-label').forEach((el) => {
        el.textContent = t.photoSoon;
      });

      document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach((btn) => {
        if (btn.dataset.lang === lang) {
          btn.className = 'lang-btn px-2.5 py-1 rounded-full bg-ink text-surface transition-all';
        } else {
          btn.className = 'lang-btn px-2.5 py-1 rounded-full text-muted hover:text-ink transition-all';
        }
      });

      renderActivePlaceInfo();
    }

    document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach((btn) => {
      btn.addEventListener('click', () => setLanguage(btn.dataset.lang!));
    });

    updateCarouselLayout();
  </script>
</Layout>
